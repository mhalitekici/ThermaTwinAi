# Render API service only. Never add these credentials to Vercel frontend variables.
APP_ENV=production
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=https://YOUR_FRONTEND.vercel.app
ALLOWED_ORIGINS=https://YOUR_FRONTEND.vercel.app
NOTIFICATION_MODE=shadow
AUTOMATIC_EMAILS_APPROVED=false
ENABLE_FORECAST_EMAILS=false
# Enable only for a deliberate self-test with a verified, consented account.
TEST_EMAIL_ENABLED=false
