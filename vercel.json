{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/alerts", "destination": "/index.html" },
    { "source": "/forecasts", "destination": "/index.html" },
    { "source": "/subscriptions", "destination": "/index.html" },
    { "source": "/regions", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/performance", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
