# Copy to .env locally. Never commit real values.
VITE_APP_MODE=demo
# Compatibility flag; VITE_APP_MODE takes precedence. Use production with real public Supabase values.
VITE_ENABLE_LIVE_INTEGRATIONS=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
SUPABASE_URL=
# Server-only: new sb_secret_ key or legacy service_role JWT. Keep the variable name for compatibility.
SUPABASE_SERVICE_ROLE_KEY=
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
COPERNICUS_DATASET_ID=SST_MED_SST_L4_NRT_OBSERVATIONS_010_004_c_V2
COPERNICUS_VARIABLE=analysed_sst
# auto: open catalogue Zarr without an account; toolbox when username is set.
COPERNICUS_ACCESS=auto
RESEND_API_KEY=
EMAIL_FROM=
# Optional; reports always have a deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Notification dispatch defaults. OTP login is independent and uses Supabase SMTP.
NOTIFICATION_MODE=shadow
AUTOMATIC_EMAILS_APPROVED=false
ENABLE_FORECAST_EMAILS=false
TEST_EMAIL_ENABLED=false
# SMTP sender address must be plain email on a Resend-verified domain.
SMTP_SENDER_EMAIL=
# Trusted runtime bundle for GitHub Actions; SHA-256 is pinned in docs/runtime-model-manifest.json.
MODEL_BUNDLE_URL=
