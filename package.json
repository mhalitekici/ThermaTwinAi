{
  "name": "thermatwin-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --strictPort",
    "dev:api": ".venv\\Scripts\\python.exe -m uvicorn thermatwin.api:app --host 127.0.0.1 --port 8000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "tsc -b && node scripts/build-demo-test.mjs && playwright test",
    "test:db": "node scripts/test-database.mjs",
    "test": "npm run test:config && npm run test:unit && npm run test:db && npm run test:e2e && npm run test:integration",
    "format": "prettier --write src vite.config.ts playwright.config.ts e2e scripts/*.mjs",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test:integration": "npm run build:integration-test && playwright test --config playwright.integration.config.ts",
    "build:integration-test": "node scripts/build-integration.mjs",
    "test:config": "node scripts/test-public-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
